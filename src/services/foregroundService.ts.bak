import notifee, { AndroidImportance } from '@notifee/react-native';

let serviceStarted = false;

export const startForegroundService = async () => {
  if (serviceStarted) return;

  try {
    // Check current status first — doesn't require an Activity.
    const settings = await notifee.getNotificationSettings();
    const alreadyAuthorized = settings.authorizationStatus >= 1; // AUTHORIZED or PROVISIONAL

    if (!alreadyAuthorized) {
      try {
        await notifee.requestPermission();
      } catch (permError) {
        console.warn(
          '[SERVICE] Could not request notification permission (likely no Activity attached):',
          permError
        );
        // Continue anyway — permission may already be granted from a
        // previous session, and the foreground service can often still
        // start even without re-prompting.
      }
    }
  } catch (e) {
    console.warn('[SERVICE] Notification settings check failed:', e);
  }

  const channelId = await notifee.createChannel({
    id: 'sms-forwarder',
    name: 'SMS Forwarder',
    importance: AndroidImportance.LOW,
  });

  try {
    await notifee.displayNotification({
      title: 'SMS Forwarder Active',
      body: 'Monitoring incoming messages in the background',
      android: {
        channelId,
        asForegroundService: true,
        ongoing: true,
        smallIcon: 'ic_launcher',
        pressAction: { id: 'default' },
      },
    });
    serviceStarted = true;
    console.log('[SERVICE] Foreground service started');
  } catch (e) {
    console.error('[SERVICE] Failed to start foreground service:', e);
    // Don't set serviceStarted = true if it actually failed
  }
};

export const stopForegroundService = async () => {
  try {
    await notifee.stopForegroundService();
  } catch (e) {
    console.warn('[SERVICE] Failed to stop foreground service:', e);
  }
  serviceStarted = false;
};